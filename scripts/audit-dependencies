#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-2-Clause
#
# Dependency audit (SDK-STANDARD "Security"): fails on ANY known-vulnerable package, direct or transitive, in any
# project of the solution, using `dotnet list package --vulnerable --include-transitive`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
report="$(mktemp)"
trap 'rm -f "$report"' EXIT
dotnet restore "$root/EnsembleWeather.sln" --nologo -v quiet
dotnet list "$root/EnsembleWeather.sln" package --vulnerable --include-transitive --format json > "$report"
python3 - "$report" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
hits = []
for project in data.get("projects", []):
    for framework in project.get("frameworks", []):
        for kind in ("topLevelPackages", "transitivePackages"):
            for package in framework.get(kind, []):
                for vuln in package.get("vulnerabilities", []):
                    hits.append(f'{project["path"]} [{framework["framework"]}] {package["id"]} {package.get("resolvedVersion")}: '
                                f'{vuln.get("severity")} {vuln.get("advisoryurl")}')
for h in hits:
    print(h, file=sys.stderr)
print(f"dependency audit: {len(data.get('projects', []))} projects, {len(hits)} vulnerable package(s)")
sys.exit(1 if hits else 0)
PY
