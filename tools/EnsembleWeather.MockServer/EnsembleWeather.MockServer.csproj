    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="bodies/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
